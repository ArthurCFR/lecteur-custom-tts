# Clé API du provider TTS (obligatoire)
TTS_API_KEY=sk-...

# Clé API Anthropic — active le prétraitement du texte pour un rendu podcast naturel (optionnel)
ANTHROPIC_API_KEY=sk-ant-...

# URL de base de l'API (optionnel — défaut: OpenAI)
TTS_BASE_URL=https://api.openai.com/v1

# Modèle TTS à utiliser (optionnel — défaut: gpt-4o-mini-tts)
TTS_MODEL=gpt-4o-mini-tts

# Voix par défaut (optionnel — défaut: alloy)
# Valeurs disponibles : alloy, nova, sage, shimmer
TTS_VOICE=alloy
